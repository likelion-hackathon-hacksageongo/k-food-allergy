# 식품안전나라 오픈API 키 (조리식품의 레시피 DB, 서비스 ID: COOKRCP01)
# https://openapi.foodsafetykorea.go.kr 에서 발급
#
# 이 파일을 data/.env 로 복사한 뒤 실제 키를 넣으세요.
# data/.env 는 gitignore 되어 있으므로 커밋되지 않습니다.
FOODSAFETY_API_KEY=your_key_here

# 서울 열린데이터광장 인증키 (마포구 일반음식점 인허가, 서비스: LOCALDATA_072404_MP)
# https://data.seoul.go.kr 에서 발급
SEOUL_API_KEY=your_key_here
