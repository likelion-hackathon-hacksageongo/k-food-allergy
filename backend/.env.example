# Copy this file to `.env` and adjust values as needed.
# `.env` is gitignored and safe for local secrets.

SECRET_KEY=django-insecure-change-this-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kakao Developers (developers.kakao.com) -> 앱 만들기 -> REST API 키
KAKAO_REST_API_KEY=your-rest-api-key
KAKAO_JS_KEY=your-js-key

# AI team's server (cd AI && uvicorn main:app --reload --port 8100)
AI_SERVICE_URL=http://localhost:8100
